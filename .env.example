# --- Supabase (required for auth + storage + db) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Extraction engine ---
# mock      = deterministic sample data, no keys needed (default)
# tesseract = free local OCR (tha+eng), no key needed, lower accuracy
# claude    = Claude vision, highest accuracy, requires ANTHROPIC_API_KEY
EXTRACTION_PROVIDER=mock

# Required only when EXTRACTION_PROVIDER=claude
ANTHROPIC_API_KEY=
# Model used for claude provider (default: claude-sonnet-4-6).
# Use claude-opus-4-8 for the hardest scans.
ANTHROPIC_MODEL=claude-sonnet-4-6
